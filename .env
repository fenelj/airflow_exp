AIRFLOW_UID=50000

# Used by config/airflow_local_settings.py to build each org's IAM ARN
# boundary (arn:<partition>:iam::<account_id>:role/<org>-...).
AWS_ACCOUNT_ID=123456789012
AWS_PARTITION=aws

# AWS Default Connection Configuration for local execution and ECS
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "extra": {"region_name": "us-east-1", "service_config": {"lambda": {"endpoint_url": "https://custom-lambda-endpoint.com"}, "ecs": {"endpoint_url": "https://custom-ecs-endpoint.com"}, "emr": {"endpoint_url": "https://custom-emr-endpoint.com"}, "glue": {"endpoint_url": "https://custom-glue-endpoint.com"}, "athena": {"endpoint_url": "https://custom-athena-endpoint.com"}, "sqs": {"endpoint_url": "https://custom-sqs-endpoint.com"}, "states": {"endpoint_url": "https://custom-states-endpoint.com"}, "events": {"endpoint_url": "https://custom-events-endpoint.com"}}}}'
